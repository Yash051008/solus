# Copy to .env.local (or run: npm run web:env from the repo root, which fills these from `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key from supabase status>
# Server-only. Used solely by adapters (KYC result recording). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase status>
# Server-only. >= 32 chars. HMAC pepper for KYC identity digests (ADR-0005).
KYC_ID_PEPPER=<random 32+ char secret>
# Only 'mock' exists until a real adapter is verified and built (ADR-0005).
KYC_PROVIDER=mock
