{
  "name": "solus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,edge-runtime,supavisor,mailpit,postgres-meta,realtime",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:node": "node --test \"tests/**/*.test.ts\" \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run --workspaces --if-present typecheck",
    "test:all": "bash scripts/test-all.sh",
    "db:types": "supabase gen types typescript --local --schema public --schema app > packages/db/src/database.types.ts",
    "web:env": "bash scripts/web-env.sh",
    "web:build": "npm run --workspace @solus/web build",
    "agent:env": "bash scripts/agent-env.sh",
    "agent:start": "npm run start --workspace @solus/agent"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.11.14",
    "pg": "8.15.6",
    "typescript": "5.8.3",
    "@supabase/supabase-js": "2.117.2",
    "@solus/core": "*",
    "@solus/db": "*",
    "@solus/integrations": "*",
    "@solus/agent-core": "*"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
